{
  "name": "@prdb/sdk",
  "version": "0.7.0",
  "description": "TypeScript SDK for the prdb Public API",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prdb-net/prdb-sdk.git",
    "directory": "typescript"
  },
  "homepage": "https://github.com/prdb-net/prdb-sdk#readme",
  "bugs": "https://github.com/prdb-net/prdb-sdk/issues",
  "keywords": ["prdb", "sdk", "api", "client"],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test .test-dist/test/*.test.js",
    "clean": "rm -rf dist .test-dist"
  },
  "dependencies": {
    "@microsoft/kiota-bundle": "1.0.0-preview.103"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  }
}
